DATABASE_URL="postgresql://renovessa:renovessa@db:5432/renovessa?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:7090"
PORT=7090

# First-job MVP wedge
FIRST_JOB_MODE=true
PILOT_TRADE=HVAC
PILOT_ZIP_CLUSTERS=22030,22031,22032,22033
PILOT_MIN_BUDGET=1000
PILOT_CONTRACTOR_ID=
NEXT_PUBLIC_OPS_PHONE=(571) 460-0006
NEXT_PUBLIC_LANDING_HEADLINE=Need HVAC help in Fairfax?

# Twilio (agent calling) — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio Voice SDK (browser softphone)
# Create an API Key at Twilio Console > Develop > API keys & tokens
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App SID — create a TwiML App (Manage > Voice > TwiML Apps) and point its
# Voice Request URL to: <TWILIO_WEBHOOK_BASE_URL or NEXT_PUBLIC_APP_URL>/api/calls/connect
TWILIO_TWIML_APP_SID=
# Public HTTPS base Twilio can reach for webhooks (required for local softphone —
# use an ngrok/localtunnel URL). Leave unset in production (uses NEXT_PUBLIC_APP_URL).
TWILIO_WEBHOOK_BASE_URL=

# OpenRouter (legacy homepage AI advisor — replaced by estimate wizard)
# Kept for optional /api/advisor use; the landing hero no longer shows the chatbot.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
NEXT_PUBLIC_AI_ADVISOR_ENABLED=false

# SendGrid (agent email) — https://app.sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=ops@renovessa.com
SENDGRID_FROM_NAME=Renovessa Ops
# Reply-to for BULK campaign sends (shared inbox). Falls back to SENDGRID_FROM_EMAIL.
SENDGRID_REPLY_TO=ops@renovessa.com
# Physical mailing address shown in the CAN-SPAM footer of every bulk email (required for cold outreach).
MAILING_ADDRESS="Renovessa, 123 Main St, Fairfax, VA 22030"
# Secret used to sign one-click unsubscribe tokens. openssl rand -base64 32
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
# Base64 public key from SendGrid's Signed Event Webhook (Settings > Mail Settings >
# Event Webhook). If unset, webhook signature verification is skipped (dev only).
SENDGRID_WEBHOOK_VERIFICATION_KEY=
# Exact estimator model version approved by the claim reviewer. Leave blank to
# withhold numeric ranges from public pages.
NEXT_PUBLIC_APPROVED_ESTIMATE_MODEL_VERSION=dmv-estimator-2026-07-23-v1

# ---------------------------------------------------------------------------
# Bathroom Remodeling Experience (PRD: Bathroom Remodeling Experience)
# All flags default OFF. Set BATHROOM_DEMO_MODE=true to enable every flag for
# local dev / demo seed. See src/lib/feature-flags.ts.
# ---------------------------------------------------------------------------
BATHROOM_DEMO_MODE=false
BATHROOM_ROCKVILLE_LANDING_ENABLED=false
BATHROOM_PLANNER_ENABLED=false
BATHROOM_DIAGRAM_BUILDER_ENABLED=false
BATHROOM_AI_INTERPRETATION_ENABLED=false
BATHROOM_ESTIMATOR_ENABLED=false
BATHROOM_PERMIT_NAVIGATOR_ENABLED=false
BATHROOM_PROJECT_BRIEF_ENABLED=false
BATHROOM_CONTRACTOR_MATCHING_ENABLED=false
BATHROOM_PROPOSAL_COMPARISON_ENABLED=false
BATHROOM_CONTRACTOR_STUDIO_ENABLED=false

# Local filesystem root for bathroom photo uploads (Docker default: /app/uploads)
UPLOAD_ROOT=

# ---------------------------------------------------------------------------
# Renovessa Solar
# See docs/planning/SOLAR_IMPLEMENTATION_NOTE.md
#
# Append these to .env. All flags default OFF; SOLAR_DEMO_MODE=true forces the
# whole set on for local dev. Flags are read at request time, so changing them
# takes effect on container restart without a rebuild.
# ---------------------------------------------------------------------------

SOLAR_DEMO_MODE=false
SOLAR_LANDING_ENABLED=false
SOLAR_PLANNER_ENABLED=false
# Google Solar API roof analysis. When off, the planner runs manual-roof only.
SOLAR_GEOSPATIAL_ENABLED=false
# NREL PVWatts v8 â€” the independent second production model.
SOLAR_PVWATTS_ENABLED=false
# OpenEI utility rate lookup.
SOLAR_UTILITY_RATES_ENABLED=false
# Incentive display. Even when on, nothing shows unless a reviewed
# SolarIncentiveProgram row exists for the jurisdiction.
SOLAR_INCENTIVES_ENABLED=false
# Battery / storage branch. Not implemented yet â€” leave off.
SOLAR_STORAGE_ENABLED=false
SOLAR_PROJECT_BRIEF_ENABLED=false

# ---------------------------------------------------------------------------
# Provider credentials â€” SERVER SIDE ONLY.
# Never prefix these with NEXT_PUBLIC_: that would ship them in the browser
# bundle and turn the planner into an open proxy for metered APIs.
# ---------------------------------------------------------------------------

# Google Maps Platform key with Geocoding API + Solar API enabled.
# Restrict it by IP to the app servers.
GOOGLE_MAPS_API_KEY=

# NREL developer key for PVWatts v8: https://developer.nrel.gov/signup/
NREL_API_KEY=

# OpenEI / URDB key (same NREL developer account works).
OPENEI_API_KEY=

# ---------------------------------------------------------------------------
# Model + retention settings
# ---------------------------------------------------------------------------

# Hard timeout for any third-party solar call, in ms.
SOLAR_PROVIDER_TIMEOUT_MS=8000

# Minimum imagery quality the Solar API must meet. HIGH rejects many DMV homes;
# LOW accepts more and the planner surfaces the quality to the homeowner.
SOLAR_REQUIRED_IMAGERY_QUALITY=LOW

# How long a licensed provider payload may be cached before it is purged.
# Renovessa-derived normalized geometry is retained regardless.
SOLAR_PROVIDER_CACHE_DAYS=30

# Incentive programs not re-verified within this many days are withheld
# rather than shown stale.
SOLAR_INCENTIVE_STALE_DAYS=180

# Hard ceiling on billed Google Solar roof analyses per UTC day, counted from
# the audit trail so it holds across restarts and containers. /solar/planner is
# public and Building Insights bills per request; the per-IP rate limiter
# bounds one caller, this bounds the aggregate bill. Exhaustion routes the
# homeowner to manual roof entry rather than an error.
# This complements — does not replace — a quota cap set in Google Cloud.
SOLAR_DAILY_ROOF_ANALYSIS_CAP=250

# ---------------------------------------------------------------------------
# FAIL-CLOSED PRICING GATE
#
# Homeowners see NO dollar figures until this exactly matches the version of a
# published SolarEstimatorConfiguration. Leave blank until a reviewer has
# approved a pricing model built from real local proposal data. The built-in
# default is an unvalidated planning default with a sample count of zero and
# must never be approved for public display.
#
# Mirrors NEXT_PUBLIC_APPROVED_ESTIMATE_MODEL_VERSION for the bathroom estimator.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APPROVED_SOLAR_PRICING_VERSION=

