generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HOMEOWNER
  CONTRACTOR
  SUPER_ADMIN
  OPS_AGENT
  SCHEDULER
  FINANCE_MANAGER
  OPS_MANAGER
  QA_MANAGER
  CONTRACTOR_ACQUISITION
}

enum LeadStatus {
  NEW
  ASSIGNED
  CALLING
  QUALIFICATION_IN_PROGRESS
  QUALIFIED
  UNQUALIFIED
  SCHEDULING
  APPOINTMENT_OFFERED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_COMPLETED
  HOMEOWNER_CONFIRMED
  BILLING_PENDING
  BILLING_APPROVED
  DISPUTED
  CLOSED
  RECYCLE
}

enum AppointmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  SCHEDULED
  REMINDER_SENT
  IN_PROGRESS
  CHECKED_IN
  COMPLETED
  HOMEOWNER_CONFIRMED
  NO_SHOW
  DISPUTED
  BILLED
  CANCELLED
}

enum ContractorTier {
  TRIAL
  STANDARD
  PREFERRED
  WATCH
  SUSPENDED
  BANNED
}

enum CapacityCellStatus {
  OPEN
  TESTING
  FULL
  WAITLIST
  PAUSED
  UNDERPERFORMING
  EXPANSION_CANDIDATE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

enum DisputeOutcome {
  BILL_STANDS
  FULL_CREDIT
  PARTIAL_CREDIT
  RESCHEDULE
  CONTRACTOR_WARNING
}

enum InvoiceStatus {
  PENDING
  APPROVED
  CHARGED
  FAILED
  CREDITED
  REFUNDED
}

enum AuditEventType {
  FORM_SUBMITTED
  CONSENT_RECORDED
  SMS_SENT
  CALL_MADE
  QUALIFICATION_DECISION
  CONTRACTOR_OFFERED
  CONTRACTOR_ACCEPTED
  CONTRACTOR_DECLINED
  CALENDAR_INVITE_SENT
  REMINDER_SENT
  CHECK_IN_RECORDED
  HOMEOWNER_CONFIRMED
  BILLING_TRIGGER
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  STATUS_CHANGED
  NOTE_ADDED
  CREDIT_ISSUED
  EMAIL_SENT
  EMAIL_REPLIED
  CAMPAIGN_SENT
  BATHROOM_PROJECT_CREATED
  BATHROOM_ESTIMATE_GENERATED
  BATHROOM_BRIEF_GENERATED
  BATHROOM_CONTACT_RELEASED
  BATHROOM_PROPOSAL_SUBMITTED
  BATHROOM_PROPOSAL_APPROVED
  BATHROOM_PROPOSAL_REVISED
  BATHROOM_PROPOSAL_SENT
  BATHROOM_PROPOSAL_VIEWED
  BATHROOM_PROPOSAL_ACCEPTED
  BATHROOM_PROPOSAL_DECLINED
  BATHROOM_PROPOSAL_QUESTION
  BATHROOM_LAYOUT_SAVED
  BATHROOM_PERMIT_ASSESSED
  BATHROOM_PHOTO_UPLOADED
  BATHROOM_DIAGRAM_SAVED
  BATHROOM_SHARE_LINK_CREATED
  BATHROOM_SHARE_LINK_REVOKED
  BATHROOM_RFP_SUBMITTED
  BATHROOM_RFP_DISPATCHED
  SOLAR_PROJECT_CREATED
  SOLAR_ADDRESS_RESOLVED
  SOLAR_BUILDING_CONFIRMED
  SOLAR_BUILDING_REJECTED
  SOLAR_ROOF_ANALYSIS_COMPLETED
  SOLAR_ROOF_ANALYSIS_FAILED
  SOLAR_MANUAL_ROOF_ENTERED
  SOLAR_LAYOUT_SAVED
  SOLAR_PRODUCTION_MODELLED
  SOLAR_PRODUCTION_MODEL_DISCREPANCY
  SOLAR_USAGE_PROVIDED
  SOLAR_TARIFF_SELECTED
  SOLAR_ESTIMATE_GENERATED
  SOLAR_BRIEF_GENERATED
  SOLAR_RFP_SUBMITTED
  SOLAR_PROVIDER_FAILURE
}

enum ConsentEventAction {
  GRANTED
  REVOKED
  ACKNOWLEDGED
}

enum CommunicationChannel {
  EMAIL
  PHONE
  SMS
}

enum CaseStudyStatus {
  DRAFT
  FINAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contractorProfile       ContractorProfile?
  projectRequests         ProjectRequest[]           @relation("HomeownerProjects")
  assignedLeads           ProjectRequest[]           @relation("AssignedAgent")
  auditEvents             AuditEvent[]               @relation("AuditActor")
  notifications           Notification[]
  approvedInvoices        Invoice[]                  @relation("ApprovedBy")
  twilioPhoneNumbers      TwilioPhoneNumber[]        @relation("AssignedAgentNumbers")
  callLogs                CallLog[]                  @relation("AgentCalls")
  emailMessages           EmailMessage[]             @relation("AgentEmails")
  emailCampaigns          EmailCampaign[]            @relation("CampaignOwner")
  consentEvents           ConsentEvent[]
  suppressions            CommunicationSuppression[]
  bathroomProjects        BathroomProject[]          @relation("HomeownerBathroomProjects")
  bathroomContactReleases BathroomContactRelease[]   @relation("BathroomContactReleaser")
  solarProjects           SolarProject[]             @relation("HomeownerSolarProjects")
}

model ContractorProfile {
  id                      String         @id @default(cuid())
  userId                  String         @unique
  companyName             String
  trade                   String
  tier                    ContractorTier @default(TRIAL)
  status                  String         @default("active")
  licenseVerified         Boolean        @default(false)
  insuranceVerified       Boolean        @default(false)
  yearsInBusiness         Int?
  employeeCount           Int?
  avgJobSize              String?
  serviceZips             String[]
  showRate                Float          @default(100)
  acceptanceRate          Float          @default(100)
  disputeRate             Float          @default(0)
  contactPerson           String?
  availabilityNotes       String?
  pilotTerms              String?
  firstAppointmentPricing String?        @default("free")
  pilotPriceAmount        Float?
  responseTimeHours       Int?
  googleBusinessUrl       String?
  internalNotes           String?
  // White-label proposal letterhead (contractor studio)
  letterheadPhone         String?
  letterheadEmail         String?
  letterheadAddress       String?
  letterheadTagline       String?
  letterheadLicenseText   String?
  proposalFooterText      String?
  /// Studio pricing defaults (markup, overhead, contingency, min margin, labor rate).
  studioPricingJson       Json?
  isDemo                  Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments            Appointment[]
  capacityCells           CapacityCell[]           @relation("CellContractors")
  invoices                Invoice[]
  disputes                Dispute[]
  callLogs                CallLog[]
  emailMessages           EmailMessage[]
  bathroomProposals       ContractorProposal[]
  bathroomContactReleases BathroomContactRelease[]
  bathroomOwnedProjects   BathroomProject[]        @relation("ContractorOwnedBathroomProjects")
}

model CapacityCell {
  id               String             @id @default(cuid())
  name             String
  trade            String
  zipCluster       String[]
  jobSizeMin       Int?
  jobSizeMax       Int?
  maxSlots         Int                @default(2)
  appointmentLimit Int                @default(20)
  status           CapacityCellStatus @default(OPEN)
  isDemo           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  contractors ContractorProfile[] @relation("CellContractors")
}

model ProjectRequest {
  id                          String     @id @default(cuid())
  referenceNumber             String     @unique
  homeownerId                 String?
  assignedAgentId             String?
  firstName                   String
  lastName                    String
  email                       String
  phone                       String
  zipCode                     String
  trade                       String
  description                 String
  urgency                     String
  budgetRange                 String
  preferredContact            String?
  tcpaConsent                 Boolean    @default(false)
  consentVersion              String?
  consentRecordedAt           DateTime?
  termsAccepted               Boolean    @default(false)
  termsVersion                String?
  termsAcceptedAt             DateTime?
  privacyAcknowledged         Boolean    @default(false)
  privacyVersion              String?
  privacyAcknowledgedAt       DateTime?
  status                      LeadStatus @default(NEW)
  source                      String     @default("organic")
  qualificationNotes          String?
  /// Immutable, display-ready snapshot of the estimator answers, estimate
  /// result, and proposal-contact form at RFQ submission time. The normalized
  /// columns above remain the routing/reporting source of truth.
  estimatorSnapshotJson       Json?
  disposition                 String?
  address                     String?
  ownershipAuthority          String?
  preferredAppointmentWindows String?
  photoUrls                   String[]
  serviceCellMatch            Boolean?
  invalidReason               String?
  reachable                   Boolean?
  isDemo                      Boolean    @default(false)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  homeowner       User?                      @relation("HomeownerProjects", fields: [homeownerId], references: [id])
  assignedAgent   User?                      @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  appointment     Appointment?
  auditEvents     AuditEvent[]
  dispute         Dispute?
  caseStudy       CaseStudy?
  callLogs        CallLog[]
  emailMessages   EmailMessage[]
  consentEvents   ConsentEvent[]
  suppressions    CommunicationSuppression[]
  bathroomProject BathroomProject?
  solarProject    SolarProject?
}

model Appointment {
  id                     String            @id @default(cuid())
  projectRequestId       String            @unique
  contractorId           String
  scheduledAt            DateTime?
  acceptedAt             DateTime?
  checkedInAt            DateTime?
  homeownerConfirmedAt   DateTime?
  status                 AppointmentStatus @default(OFFERED)
  calendarInviteSent     Boolean           @default(false)
  billingTriggered       Boolean           @default(false)
  billingApproved        Boolean           @default(false)
  amount                 Float?
  location               String?
  homeownerPreConfirmed  Boolean           @default(false)
  contractorPreConfirmed Boolean           @default(false)
  estimateGiven          String?
  contractorOutcomeNotes String?
  homeownerOutcomeNotes  String?
  followUpRequired       Boolean           @default(false)
  opportunitySentAt      DateTime?
  declineReason          String?
  pilotBillableReason    String?
  isDemo                 Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  projectRequest    ProjectRequest       @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  contractor        ContractorProfile    @relation(fields: [contractorId], references: [id])
  invoice           Invoice?
  auditEvents       AuditEvent[]
  feedbacks         Feedback[]
  bathroomProposals ContractorProposal[]
}

model AuditEvent {
  id               String         @id @default(cuid())
  eventType        AuditEventType
  description      String
  metadata         Json?
  actorId          String?
  projectRequestId String?
  appointmentId    String?
  createdAt        DateTime       @default(now())

  actor           User?            @relation("AuditActor", fields: [actorId], references: [id])
  projectRequest  ProjectRequest?  @relation(fields: [projectRequestId], references: [id])
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id])
  bathroomProject BathroomProject? @relation("BathroomProjectAudit", fields: [bathroomProjectId], references: [id], onDelete: SetNull)
  solarProject    SolarProject?    @relation("SolarProjectAudit", fields: [solarProjectId], references: [id], onDelete: SetNull)

  bathroomProjectId String?
  solarProjectId    String?
}

model Dispute {
  id               String          @id @default(cuid())
  projectRequestId String          @unique
  contractorId     String
  status           DisputeStatus   @default(OPEN)
  outcome          DisputeOutcome?
  reason           String
  evidenceScore    Int             @default(0)
  resolutionNotes  String?
  isDemo           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  projectRequest ProjectRequest    @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  contractor     ContractorProfile @relation(fields: [contractorId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  contractorId  String
  amount        Float
  status        InvoiceStatus @default(PENDING)
  pilotProof    Boolean       @default(true)
  waivedReason  String?
  approvedById  String?
  approvedAt    DateTime?
  isDemo        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  contractor  ContractorProfile @relation(fields: [contractorId], references: [id])
  approvedBy  User?             @relation("ApprovedBy", fields: [approvedById], references: [id])
}

model Feedback {
  id            String   @id @default(cuid())
  appointmentId String
  actorType     String
  responses     Json
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model CaseStudy {
  id                 String          @id @default(cuid())
  projectRequestId   String          @unique
  trade              String
  zipCode            String
  leadSource         String?
  timingMetrics      Json?
  homeownerConfirmed Boolean         @default(false)
  contractorAttended Boolean         @default(false)
  estimateGiven      String?
  disputeOccurred    Boolean         @default(false)
  lessonsLearned     String?
  nextImprovement    String?
  status             CaseStudyStatus @default(DRAFT)
  createdAt          DateTime        @default(now())

  projectRequest ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
}

model ContractorInquiry {
  id                String    @id @default(cuid())
  companyName       String
  contactName       String
  phone             String
  email             String
  trade             String
  serviceZips       String
  yearsInBusiness   Int?
  employeeCount     Int?
  licensedInsured   Boolean   @default(false)
  usesLeadGen       Boolean   @default(false)
  avgJobSize        String?
  referralSource    String?
  // Cold-outreach prospect fields (populated by the DMV scraper import). These
  // carry through to the email merge context so bulk sends can personalize with
  // the prospect's city and review rating.
  city              String?
  state             String?
  rating            String?
  reviewCount       Int?
  website           String?
  source            String?
  licenseRegNumber  String?
  licenseExpiration DateTime?
  status            String    @default("new")
  isDemo            Boolean   @default(false)
  createdAt         DateTime  @default(now())

  tags ContactTagInquiry[]

  @@index([status])
  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwilioPhoneNumber {
  id             String   @id @default(cuid())
  phoneNumber    String   @unique
  label          String?
  assignedUserId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedUser User?     @relation("AssignedAgentNumbers", fields: [assignedUserId], references: [id])
  callLogs     CallLog[]
}

model CallLog {
  id                  String    @id @default(cuid())
  twilioCallSid       String    @unique
  direction           String    @default("outbound")
  fromNumber          String
  toNumber            String
  status              String    @default("initiated")
  durationSeconds     Int?
  disposition         String?
  dispositionNote     String?
  agentId             String?
  twilioPhoneNumberId String?
  projectRequestId    String?
  contractorId        String?
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  agent             User?              @relation("AgentCalls", fields: [agentId], references: [id])
  twilioPhoneNumber TwilioPhoneNumber? @relation(fields: [twilioPhoneNumberId], references: [id])
  projectRequest    ProjectRequest?    @relation(fields: [projectRequestId], references: [id])
  contractor        ContractorProfile? @relation(fields: [contractorId], references: [id])
}

model EmailMessage {
  id                String    @id @default(cuid())
  sendgridMessageId String?
  fromEmail         String
  toEmail           String
  subject           String
  body              String
  status            String    @default("sent")
  // "outbound" for sends; "inbound" for replies captured via the SendGrid
  // Inbound Parse webhook. Inbound rows reuse this table so a prospect's replies
  // sit alongside our sends in the same communication timeline.
  direction         String    @default("outbound")
  // For an inbound reply, the id of the outbound EmailMessage it is replying to
  // (matched by sender address at parse time). Null for outbound and unmatched.
  replyToMessageId  String?
  agentId           String?
  projectRequestId  String?
  contractorId      String?
  campaignId        String?
  // Delivery lifecycle timestamps, populated by the SendGrid event webhook.
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  spamReportedAt    DateTime?
  unsubscribedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agent          User?              @relation("AgentEmails", fields: [agentId], references: [id])
  projectRequest ProjectRequest?    @relation(fields: [projectRequestId], references: [id])
  contractor     ContractorProfile? @relation(fields: [contractorId], references: [id])
  campaign       EmailCampaign?     @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([sendgridMessageId])
}

/**
 * A bulk outreach send to a resolved audience segment. Holds the template used,
 * the resolved filter, and running counters. Each recipient gets its own
 * EmailMessage row (campaignId back-reference) so bulk sends still appear in the
 * per-contact communication timeline.
 */
model EmailCampaign {
  id              String    @id @default(cuid())
  name            String
  audience        String
  subject         String
  bodyTemplate    String
  bodyHtml        String? // HTML version from TipTap editor
  templateId      String?
  emailTemplateId String?
  // JSON-encoded segment filter used to resolve recipients (trade, zips, status…).
  filters         Json?
  replyTo         String?
  status          String    @default("draft") // draft | sending | sent | failed
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  ownerAgentId    String?
  clonedFromId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner           User?           @relation("CampaignOwner", fields: [ownerAgentId], references: [id])
  messages        EmailMessage[]
  emailTemplate   EmailTemplate?  @relation(fields: [emailTemplateId], references: [id])
  clonedFrom      EmailCampaign?  @relation("CampaignClones", fields: [clonedFromId], references: [id])
  clonedCampaigns EmailCampaign[] @relation("CampaignClones")
}

/**
 * Addresses that must never receive email — unsubscribes, hard bounces, and
 * spam complaints. The segment resolver and bulk sender both filter against
 * this table. Populated by the public unsubscribe route and (phase 2) the
 * SendGrid event webhook.
 */
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // unsubscribe | bounce | complaint | manual
  createdAt DateTime @default(now())

  @@index([email])
}

/**
 * Immutable evidence for communication consent, legal clickwrap, and revocation.
 * The server writes the exact disclosure text and version; clients cannot choose it.
 */
model ConsentEvent {
  id               String                 @id @default(cuid())
  action           ConsentEventAction
  purpose          String
  channels         CommunicationChannel[]
  subjectEmail     String?
  subjectPhone     String?
  documentVersion  String
  disclosureText   String
  source           String
  ipAddress        String?
  userAgent        String?
  projectRequestId String?
  userId           String?
  createdAt        DateTime               @default(now())

  projectRequest ProjectRequest? @relation(fields: [projectRequestId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectRequestId, createdAt])
  @@index([subjectEmail, createdAt])
  @@index([subjectPhone, createdAt])
}

/**
 * Current do-not-contact state by normalized address/number and channel.
 */
model CommunicationSuppression {
  id               String               @id @default(cuid())
  channel          CommunicationChannel
  normalizedValue  String
  reason           String
  source           String
  projectRequestId String?
  userId           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  projectRequest ProjectRequest? @relation(fields: [projectRequestId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([channel, normalizedValue])
  @@index([normalizedValue])
}

model ContactTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#b5541e")
  createdAt DateTime @default(now())

  assignments ContactTagInquiry[]
}

model ContactTagInquiry {
  id         String   @id @default(cuid())
  tagId      String
  inquiryId  String
  assignedAt DateTime @default(now())

  tag     ContactTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  inquiry ContractorInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@unique([tagId, inquiryId])
  @@index([inquiryId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  audience  String // "homeowner" | "contractor" | "prospect_contractor"
  subject   String
  bodyHtml  String   @db.Text
  bodyText  String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns EmailCampaign[]

  @@index([audience])
}

// ===========================================================================
// Bathroom Remodeling Experience
// See docs/planning/BATHROOM_REMODELING_IMPLEMENTATION_NOTE.md
// All models are additive; no existing model is altered.
// ===========================================================================

enum BathroomProjectStatus {
  DRAFT
  IN_PROGRESS
  BRIEF_READY
  RFQ_SUBMITTED
  MATCHING
  CONTRACTOR_INVITED
  CONTACT_RELEASED
  PROPOSAL_RECEIVED
  CLOSED
  WITHDRAWN
}

enum BathroomLayoutType {
  EXISTING
  PROPOSED
  ESSENTIAL
  BALANCED
  PREMIUM
}

enum EstimatorConfigStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum PermitLikelihood {
  LIKELY_REQUIRED
  MAY_BE_REQUIRED
  CONTRACTOR_VERIFICATION_NEEDED
  JURISDICTION_REVIEW_NEEDED
  UNLIKELY
}

enum BathroomProposalStatus {
  DRAFT
  APPROVED
  SENT
  REVISION_REQUESTED
  SUBMITTED
  WITHDRAWN
  EXPIRED
  ACCEPTED
  DECLINED
}

/// Top-level bathroom remodeling project. Linked to a homeowner User when
/// authenticated; anonymous drafts carry a clientGeneratedId instead.
/// Contractor-owned jobs (proposal studio) use contractorOwnerId and do not
/// change the public homeowner planner flow.
model BathroomProject {
  id                   String                @id @default(cuid())
  referenceNumber      String                @unique
  homeownerId          String?
  /// Contractor who owns this job in the white-label proposal studio.
  contractorOwnerId    String?
  // When the homeowner promotes this to a bid request, the resulting RFQ.
  projectRequestId     String?               @unique
  status               BathroomProjectStatus @default(DRAFT)
  plannerMode          String                @default("detailed") // "quick" | "detailed"
  bathroomType         String?
  projectObjective     String?
  propertyType         String?
  ownershipStatus      String?
  occupancyStatus      String?
  jurisdictionStatus   String?
  budgetMinimum        Int?
  budgetMaximum        Int?
  desiredStartDate     String?
  timelineCategory     String?
  qualificationGrade   String?
  confidenceScore      String? // stores ConfidenceLevel
  currentStep          String?
  completionPercentage Int                   @default(0)
  // Freeform planner answers blob (Phase 1 autosave). Structured fields above
  // remain the canonical source for reporting; this captures the full answer
  // set including measurements, finishes, conditions, and permit answers.
  answersJson          Json?
  // Anonymous draft linkage (client-generated UUID persisted in localStorage).
  clientGeneratedId    String?
  /// Contractor studio: their client's display name / contact (not Renovessa homeowner).
  clientName           String?
  clientEmail          String?
  clientPhone          String?
  jobTitle             String?
  isDemo               Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  homeowner         User?                    @relation("HomeownerBathroomProjects", fields: [homeownerId], references: [id], onDelete: Cascade)
  contractorOwner   ContractorProfile?       @relation("ContractorOwnedBathroomProjects", fields: [contractorOwnerId], references: [id], onDelete: Cascade)
  projectRequest    ProjectRequest?          @relation(fields: [projectRequestId], references: [id], onDelete: SetNull)
  measurements      BathroomMeasurement[]
  layouts           BathroomLayout[]
  conditions        BathroomCondition[]
  selections        BathroomSelection[]
  estimates         BathroomEstimate[]
  permitAssessments PermitAssessment[]
  briefs            ProjectBrief[]
  proposals         ContractorProposal[]
  auditEvents       AuditEvent[]             @relation("BathroomProjectAudit")
  contactReleases   BathroomContactRelease[]
  media             BathroomMedia[]

  @@index([homeownerId])
  @@index([contractorOwnerId])
  @@index([status])
  @@index([clientGeneratedId])
}

/// Uploaded photo or sketch for a bathroom project (existing conditions, inspiration, plans).
model BathroomMedia {
  id          String   @id @default(cuid())
  projectId   String
  kind        String   @default("photo") // photo | sketch | plan | other
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  caption     String?
  wallLabel   String? // e.g. "north wall", "ceiling above shower"
  createdAt   DateTime @default(now())

  project BathroomProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BathroomMeasurement {
  id                String    @id @default(cuid())
  projectId         String
  measurementMethod String // "simple" | "guided" | "manual" | "upload"
  unitSystem        String    @default("imperial")
  ceilingHeight     Float?
  isConfirmed       Boolean   @default(false)
  confirmedAt       DateTime?
  source            String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project BathroomProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BathroomLayout {
  id              String             @id @default(cuid())
  projectId       String
  layoutType      BathroomLayoutType
  version         Int                @default(1)
  name            String?
  geometryJson    Json
  calculationJson Json?
  validationJson  Json?
  isActive        Boolean            @default(true)
  isConfirmed     Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  project  BathroomProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fixtures BathroomFixture[]

  @@index([projectId, layoutType])
}

model BathroomFixture {
  id             String   @id @default(cuid())
  layoutId       String
  fixtureType    String
  positionX      Float
  positionY      Float
  width          Float?
  depth          Float?
  rotation       Float    @default(0)
  existingStatus String?
  proposedAction String?
  qualityTier    String?
  brand          String?
  model          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  layout BathroomLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
}

model BathroomCondition {
  id                 String   @id @default(cuid())
  projectId          String
  conditionType      String
  severity           String?
  homeownerReported  Boolean  @default(true)
  inspectionRequired Boolean  @default(false)
  notes              String?
  mediaIds           String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project BathroomProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BathroomSelection {
  id            String   @id @default(cuid())
  projectId     String
  category      String
  selectionType String?
  qualityTier   String?
  brand         String?
  model         String?
  quantity      Float?
  unit          String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project BathroomProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
}

/// Versioned, dated, status-controlled estimator configuration. Every
/// generated BathroomEstimate references the exact configuration version used.
model EstimatorConfiguration {
  id                String                @id @default(cuid())
  name              String
  version           String                @unique
  locationId        String?
  tradeId           String?
  validFrom         DateTime
  validTo           DateTime?
  status            EstimatorConfigStatus @default(DRAFT)
  configurationJson Json
  methodology       String?
  createdBy         String?
  approvedBy        String?
  createdAt         DateTime              @default(now())
  publishedAt       DateTime?

  estimates BathroomEstimate[]

  @@index([status])
  @@index([version])
}

model BathroomEstimate {
  id                   String          @id @default(cuid())
  projectId            String
  /// Null when computed from the built-in default config (no published row).
  configurationId      String?
  version              Int             @default(1)
  lowAmount            Int
  expectedLowAmount    Int
  expectedHighAmount   Int
  highComplexityAmount Int
  contingencyAmount    Int
  confidenceLevel      ConfidenceLevel
  assumptionsJson      Json
  unknownsJson         Json
  exclusionsJson       Json
  costDriversJson      Json
  inputSnapshotJson    Json
  createdAt            DateTime        @default(now())

  project       BathroomProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configuration EstimatorConfiguration?    @relation(fields: [configurationId], references: [id])
  lineItems     BathroomEstimateLineItem[]
  proposals     ContractorProposal[]

  @@index([projectId])
  @@index([configurationId])
}

model BathroomEstimateLineItem {
  id                   String  @id @default(cuid())
  estimateId           String
  category             String
  description          String
  quantity             Float
  unit                 String
  unitRate             Float
  lowAmount            Int
  highAmount           Int
  multiplier           Float   @default(1)
  calculationReference String?
  sortOrder            Int     @default(0)

  estimate BathroomEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model PermitAssessment {
  id                         String           @id @default(cuid())
  projectId                  String
  jurisdiction               String
  buildingPermitLikelihood   PermitLikelihood
  plumbingPermitLikelihood   PermitLikelihood
  electricalPermitLikelihood PermitLikelihood
  mechanicalPermitLikelihood PermitLikelihood
  hoaReviewLikelihood        PermitLikelihood
  reviewRequired             Boolean          @default(false)
  assumptionsJson            Json
  sourceVersion              String
  createdAt                  DateTime         @default(now())

  project BathroomProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectBrief {
  id             String    @id @default(cuid())
  projectId      String
  version        Int       @default(1)
  briefJson      Json
  pdfUrl         String?
  shareToken     String?   @unique
  shareExpiresAt DateTime?
  createdAt      DateTime  @default(now())

  project BathroomProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Structured contractor proposal for a bathroom project. Does not duplicate
/// Appointment; linked to it when an appointment is scheduled.
model ContractorProposal {
  id                     String                 @id @default(cuid())
  projectId              String
  contractorId           String
  appointmentId          String?
  /// Optional link to the BathroomEstimate that seeded line items.
  estimateId             String?
  status                 BathroomProposalStatus @default(SUBMITTED)
  /// Studio version number; increments when a revised draft is created from an approved proposal.
  version                Int                    @default(1)
  /// quick | detailed | site_verified
  mode                   String                 @default("detailed")
  totalPrice             Int
  /// Internal direct cost total (materials + labor + other) before profit.
  directCostTotal        Int?
  overheadAmount         Int?
  contingencyAmount      Int?
  profitAmount           Int?
  /// Gross margin as percent of customer price (0–100).
  grossMarginPercent     Float?
  /// Markup applied as percent of direct cost (0–100).
  markupPercent          Float?
  /// Editable contractor-priced line items (JSON array). Internal only.
  lineItemsJson          Json?
  /// Snapshot of studio pricing settings at last recalc / approval.
  pricingSnapshotJson    Json?
  includedScope          String
  exclusions             String
  materialAllowances     String?
  fixtureAllowances      String?
  permitHandling         String?
  estimatedStartDate     String?
  estimatedDuration      String?
  paymentSchedule        String?
  warranty               String?
  changeOrderProcess     String?
  optionalUpgrades       String?
  /// Contractor-suggested scope/layout/price changes for the client to consider.
  suggestedChanges       String?
  expirationDate         DateTime?
  proposalDocumentUrl    String?
  approvedAt             DateTime?
  approvedByUserId       String?
  /// Secure homeowner share link (tokenized; no account required).
  shareToken             String?                @unique
  shareExpiresAt         DateTime?
  sentAt                 DateTime?
  firstViewedAt          DateTime?
  lastViewedAt           DateTime?
  viewCount              Int                    @default(0)
  acceptedAt             DateTime?
  declinedAt             DateTime?
  acceptanceName         String?
  acceptanceEmail        String?
  acceptanceIp           String?
  /// Immutable customer-facing snapshot at acceptance time.
  acceptanceSnapshotJson Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  project        BathroomProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor     ContractorProfile           @relation(fields: [contractorId], references: [id])
  appointment    Appointment?                @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  estimate       BathroomEstimate?           @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  clientMessages ContractorProposalMessage[]

  @@index([projectId])
  @@index([contractorId])
  @@index([estimateId])
  @@index([status])
}

/// Homeowner questions / revision requests against a shared proposal.
model ContractorProposalMessage {
  id          String   @id @default(cuid())
  proposalId  String
  kind        String // question | revision_request | decline_note | contractor_reply
  body        String   @db.Text
  authorName  String?
  authorEmail String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  proposal ContractorProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

/// Audit record for every contact release to a contractor.
model BathroomContactRelease {
  id           String   @id @default(cuid())
  projectId    String
  contractorId String
  releasedBy   String
  reason       String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  project    BathroomProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor ContractorProfile @relation(fields: [contractorId], references: [id])
  releaser   User              @relation("BathroomContactReleaser", fields: [releasedBy], references: [id])

  @@index([projectId])
  @@index([contractorId])
}

/// Admin-managed authority content blocks (cost guide, permit guide, FAQ, etc.).
model BathroomContentVersion {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  bodyHtml           String    @db.Text
  bodyText           String    @db.Text
  author             String?
  reviewer           String?
  methodology        String?
  sourceLinks        String[]
  editorialNotes     String?
  applicableLocation String?
  applicableTrade    String?
  status             String    @default("draft") // draft | published | retired
  changeHistory      Json?
  lastReviewedAt     DateTime?
  lastUpdatedAt      DateTime  @default(now())
  createdAt          DateTime  @default(now())

  @@index([slug])
  @@index([status])
}

// ===========================================================================
// Solar experience â€” see docs/planning/SOLAR_IMPLEMENTATION_NOTE.md
//
// Design notes:
//  - Licensed third-party source data lives in SolarRoofAnalysis.rawProviderPayload
//    with providerDataExpiresAt, so it can be purged on its own retention clock
//    without destroying the homeowner's project (Â§49, Â§52).
//  - Every persisted estimate carries an input snapshot plus the calculation and
//    pricing versions that produced it, so old results stay reproducible (Â§48).
//  - Solar promotes into the shared ProjectRequest lead pipeline rather than
//    forking contractor matching.
// ===========================================================================

enum SolarProjectStatus {
  DRAFT
  IN_PROGRESS
  ANALYSIS_READY
  PLAN_READY
  BRIEF_READY
  RFQ_SUBMITTED
  CLOSED
  WITHDRAWN
}

enum SolarRoofDataSource {
  PROVIDER
  MANUAL
}

enum SolarConfidenceLevel {
  HIGH
  MEDIUM
  PRELIMINARY
}

enum SolarConfigStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum SolarIncentiveStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum SolarJurisdictionLevel {
  FEDERAL
  STATE
  COUNTY
  MUNICIPAL
  UTILITY
}

/// Top-level solar project. Anonymous drafts carry clientGeneratedId, matching
/// the bathroom planner's proven anonymous-draft pattern.
model SolarProject {
  id                String             @id @default(cuid())
  referenceNumber   String             @unique
  homeownerId       String?
  projectRequestId  String?            @unique
  status            SolarProjectStatus @default(DRAFT)
  plannerMode       String             @default("quick")
  currentStep       String?
  clientGeneratedId String?

  // Address / geocode (Renovessa-derived; safe to retain).
  formattedAddress    String?
  streetLine          String?
  city                String?
  state               String?
  postalCode          String?
  county              String?
  latitude            Float?
  longitude           Float?
  geocodeQuality      String?
  /// Homeowner explicitly confirmed the analysed building is theirs (Â§9).
  buildingConfirmed   Boolean   @default(false)
  buildingConfirmedAt DateTime?

  propertyType     String?
  ownershipStatus  String?
  occupancyStatus  String?
  projectGoal      String?
  timelineCategory String?

  /// Full planner answer blob for autosave; structured columns stay canonical.
  answersJson Json?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeowner           User?                     @relation("HomeownerSolarProjects", fields: [homeownerId], references: [id], onDelete: Cascade)
  projectRequest      ProjectRequest?           @relation(fields: [projectRequestId], references: [id], onDelete: SetNull)
  roofAnalyses        SolarRoofAnalysis[]
  layouts             SolarPanelLayout[]
  productionEstimates SolarProductionEstimate[]
  costEstimates       SolarCostEstimate[]
  energyProfile       SolarEnergyProfile?
  tariffs             SolarTariffSnapshot[]
  documents           SolarDocument[]
  briefs              SolarProjectBrief[]
  auditEvents         AuditEvent[]              @relation("SolarProjectAudit")

  @@index([homeownerId])
  @@index([status])
  @@index([clientGeneratedId])
}

/// One roof analysis run. Normalized fields are Renovessa-derived and retained;
/// rawProviderPayload is licensed source data on its own retention clock.
model SolarRoofAnalysis {
  id         String              @id @default(cuid())
  projectId  String
  source     SolarRoofDataSource
  providerId String
  isActive   Boolean             @default(true)

  buildingLatitude     Float
  buildingLongitude    Float
  imageryDate          String?
  imageryProcessedDate String?
  imageryQuality       String?

  /// Normalized RoofSegment[] â€” Renovessa's own derived representation.
  segmentsJson        Json
  /// Normalized CandidatePanel[].
  candidatePanelsJson Json
  /// PanelSpecification actually used (never an assumed wattage).
  panelSpecJson       Json

  maxPanelCount              Int
  maxArrayAreaMeters2        Float?
  wholeRoofAreaMeters2       Float?
  maxSunshineHoursPerYear    Float?
  carbonOffsetFactorKgPerMwh Float?

  /// Licensed third-party payload. Nullable and purgeable independently (Â§52).
  rawProviderPayload    Json?
  providerDataExpiresAt DateTime?

  retrievedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  project SolarProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
  @@index([providerDataExpiresAt])
}

/// A saved panel arrangement. Stores the homeowner's selection rather than a
/// re-derived layout, so their edits survive a provider re-analysis.
model SolarPanelLayout {
  id                     String   @id @default(cuid())
  projectId              String
  roofAnalysisId         String?
  version                Int      @default(1)
  strategy               String
  selectedPanelIds       String[]
  excludedSegmentIndices Int[]
  targetOffsetFraction   Float?
  panelCount             Int
  panelCapacityWatts     Float
  dcSystemSizeKw         Float
  isActive               Boolean  @default(true)
  calculationVersion     String
  createdAt              DateTime @default(now())

  project SolarProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
}

/// A production modelling run: both models plus the reconciliation outcome.
model SolarProductionEstimate {
  id                 String   @id @default(cuid())
  projectId          String
  layoutId           String?
  annualAcKwh        Float?
  rangeLowKwh        Float?
  rangeHighKwh       Float?
  monthlyAcKwhJson   Json?
  agreement          String
  differencePercent  Float?
  /// Each model's raw output plus notes â€” the discrepancy log (Â§17).
  modelsJson         Json
  failuresJson       Json
  assumptionsJson    Json
  calculationVersion String
  createdAt          DateTime @default(now())

  project SolarProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Household energy profile. Confirmed values stay distinct from extracted ones.
model SolarEnergyProfile {
  id                        String   @id @default(cuid())
  projectId                 String   @unique
  basis                     String
  annualKwh                 Float?
  monthlyKwhJson            Json?
  averageMonthlyBillDollars Float?
  blendedRateDollarsPerKwh  Float?
  fixedMonthlyChargeDollars Float?
  /// Homeowner-declared future loads (EV, heat pump, ...). Never inferred.
  futureLoadsJson           Json?
  assumptionsJson           Json?
  anomaliesJson             Json?
  calculationVersion        String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  project SolarProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// A tariff we retrieved, with its freshness and whether the homeowner owned it.
model SolarTariffSnapshot {
  id                             String   @id @default(cuid())
  projectId                      String
  providerId                     String
  tariffId                       String
  utilityName                    String
  tariffName                     String
  effectiveDate                  String?
  blendedEnergyRateDollarsPerKwh Float?
  fixedMonthlyChargeDollars      Float?
  hasComplexStructure            Boolean  @default(true)
  sourceUri                      String?
  retrievedAt                    DateTime
  homeownerConfirmed             Boolean  @default(false)
  isActive                       Boolean  @default(true)
  createdAt                      DateTime @default(now())

  project SolarProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
}

/// Versioned solar cost estimate. inputSnapshotJson plus the version columns
/// are what keep a historical estimate explainable after the rules change.
model SolarCostEstimate {
  id                      String               @id @default(cuid())
  projectId               String
  layoutId                String?
  configurationId         String?
  installedCostLow        Int
  installedCostHigh       Int
  netCostLow              Int?
  netCostHigh             Int?
  dollarsPerWattLow       Float
  dollarsPerWattHigh      Float
  /// False when the pricing config was not approved for public display.
  displayable             Boolean              @default(false)
  withheldReason          String?
  confidenceLevel         SolarConfidenceLevel
  lineItemsJson           Json
  appliedIncentivesJson   Json
  assumptionsJson         Json
  exclusionsJson          Json
  costDriversJson         Json
  confidenceJson          Json
  inputSnapshotJson       Json
  pricingConfigVersion    String
  calculationVersionsJson Json
  createdAt               DateTime             @default(now())

  project       SolarProject                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configuration SolarEstimatorConfiguration? @relation(fields: [configurationId], references: [id])

  @@index([projectId])
  @@index([configurationId])
}

/// Versioned, reviewable pricing + model configuration (Â§47).
model SolarEstimatorConfiguration {
  id                   String            @id @default(cuid())
  name                 String
  version              String            @unique
  market               String
  /// unvalidated_planning_default | renovessa_market_data | reviewed_external_benchmark
  dataBasis            String            @default("unvalidated_planning_default")
  sampleCount          Int               @default(0)
  mostRecentSampleDate DateTime?
  validFrom            DateTime
  validTo              DateTime?
  status               SolarConfigStatus @default(DRAFT)
  configurationJson    Json
  methodology          String?
  createdBy            String?
  approvedBy           String?
  createdAt            DateTime          @default(now())
  publishedAt          DateTime?

  estimates SolarCostEstimate[]

  @@index([status])
  @@index([version])
}

/// Reviewed incentive register. Nothing is displayed unless a row exists here
/// with a source, effective dates and a verification stamp (Â§26â€“28).
model SolarIncentiveProgram {
  id                    String                 @id @default(cuid())
  name                  String
  jurisdiction          String
  jurisdictionLevel     SolarJurisdictionLevel
  stateCode             String?
  countyName            String?
  administrator         String?
  technology            String                 @default("Solar Photovoltaic")
  incentiveType         String
  /// PERCENT_OF_COST | DOLLARS_PER_WATT | FLAT_AMOUNT | OTHER
  valueType             String
  value                 Float?
  maximumAmount         Float?
  eligibilitySummary    String                 @db.Text
  /// POTENTIALLY_APPLICABLE | LIKELY_APPLICABLE | REQUIRES_VERIFICATION
  applicability         String                 @default("REQUIRES_VERIFICATION")
  homeownerRequirements Json?
  effectiveFrom         DateTime?
  expiresOn             DateTime?
  sourceName            String
  sourceUrl             String
  lastVerifiedAt        DateTime
  verifiedBy            String?
  status                SolarIncentiveStatus   @default(DRAFT)
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, jurisdictionLevel])
  @@index([stateCode])
}

/// Homeowner-uploaded documents (utility bills, panel/meter/roof photos).
/// Stored outside the public web root and served through an authorized route.
model SolarDocument {
  id                   String   @id @default(cuid())
  projectId            String
  /// utility_bill | main_panel_photo | meter_photo | roof_photo | attic_photo | existing_solar | other
  kind                 String
  fileName             String
  mimeType             String
  sizeBytes            Int
  storagePath          String
  caption              String?
  /// AI extraction draft, if any. Never used unconfirmed in a calculation (Â§19).
  extractionJson       Json?
  extractionConfidence Float?
  homeownerConfirmed   Boolean  @default(false)
  createdAt            DateTime @default(now())

  project SolarProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Contractor-ready Solar Project Brief snapshot.
model SolarProjectBrief {
  id             String    @id @default(cuid())
  projectId      String
  version        Int       @default(1)
  briefJson      Json
  schemaVersion  String
  shareToken     String?   @unique
  shareExpiresAt DateTime?
  createdAt      DateTime  @default(now())

  project SolarProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
